generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model mt_portfolio {
  id                 Int                  @id @default(autoincrement())
  characterName      String
  workTitle          String
  imageUrl           String
  order              Int                  @default(0)
  published          Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  description        String?              @db.VarChar(200)
  mt_portfolio_image mt_portfolio_image[]
}

model mt_portfolio_image {
  id           Int          @id @default(autoincrement())
  portfolioId  Int
  imageUrl     String
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  mt_portfolio mt_portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mt_portfolio_image_portfolio_fk")

  @@index([portfolioId], map: "idx_mt_portfolio_image_portfolio")
}

model mt_customer {
  id               Int                @id @default(autoincrement())
  name             String
  phone            String             @unique(map: "mt_customer_phone_unique")
  point            Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
  mt_point_history mt_point_history[]
}

model mt_point_history {
  id          Int         @id @default(autoincrement())
  customerId  Int
  amount      Int
  reason      String?
  balance     Int
  createdAt   DateTime    @default(now())
  mt_customer mt_customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mt_point_history_customer_fk")

  @@index([customerId], map: "idx_mt_point_history_customer")
}

model mt_shop_status {
  id        Int      @id @default(autoincrement())
  status    String   @default("OPEN")
  memo      String?
  updatedAt DateTime @default(now())
}
